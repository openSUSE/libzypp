msgstr "ຂໍ້ຄວາມການສອບຖາມ LDAP URL ບໍ່ຖືກຕ້ອງ"

#: zypp-logic/zypp-core/Url.cc:159
#, c-format, boost-format
msgid "Invalid LDAP URL query parameter '%s'"
msgstr "ພາຣາມີເຕີການສອບຖາມ LDAP URL '%s' ບໍ່ຖືກຕ້ອງ"

#: zypp-logic/zypp-core/Url.cc:319
msgid "Unable to clone Url object"
msgstr "ບໍ່ສາມາດຄັດລອກວັດຖຸ Url ໄດ້"

#: zypp-logic/zypp-core/Url.cc:332
msgid "Invalid empty Url object reference"
msgstr "ການອ້າງອີງວັດຖຸ Url ທີ່ວ່າງເປົ່າບໍ່ຖືກຕ້ອງ"

#: zypp-logic/zypp-core/Url.cc:345 zypp-logic/zypp-core/Url.cc:359
